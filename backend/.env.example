# ScanWise AI backend configuration.  Copy to backend/.env and edit.
# Secrets live ONLY here (or in real environment variables) — never in the UI, logs or API responses.

# ---------------------------------------------------------------------------
# Vision model (optional, recommended for maximum accuracy).
# Without a key, documents are read with OCR + layout analysis only.
# LLM_PROVIDER=auto picks the first provider below that has a key.
# ---------------------------------------------------------------------------
LLM_PROVIDER=auto              # auto | openai | gemini | anthropic | nvidia | compatible | none

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_REASONING_EFFORT=low   # reasoning models only (o-series, gpt-5, gpt-6...): none|low|medium|high (minimal on older ones). Lower = much faster; "" = model default (slowest)

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# NVIDIA (build.nvidia.com / NIM — OpenAI-compatible). Many NIM vision models accept one image per call.
# NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct
# NVIDIA_PAGES_PER_CALL=1

# Any other OpenAI-compatible vision endpoint (Ollama, vLLM, LM Studio, OpenRouter, Azure-compatible gateways…)
# COMPATIBLE_BASE_URL=http://localhost:11434/v1
# COMPATIBLE_MODEL=qwen2.5vl:7b
# COMPATIBLE_API_KEY=

# LLM_TIMEOUT_S=180
# LLM_MAX_PAGES=12            # pages sent to the vision model per document
# LLM_PAGES_PER_CALL=4
# LLM_IMAGE_MAX_SIDE=2000
# LLM_SPLIT_CALL=true         # ask for header / totals / line items as 3 parallel requests: same fields, ~2x faster, ~1.5x input tokens
# LLM_PARALLEL_CALLS=4        # max simultaneous vision requests within one scan

# ---------------------------------------------------------------------------
# OCR
# ---------------------------------------------------------------------------
# OCR_ENGINE=rapidocr          # rapidocr (PP-OCRv6 on ONNX Runtime) | paddleocr | tesseract
# OCR_MODEL_SIZE=small         # tiny | small | medium | server  (bigger = slower; small is the best speed/accuracy trade-off on CPU)
# OCR_MAX_SIDE=2400
# REVIEW_CONF_THRESHOLD=0.90       # numbers/dates/codes below this OCR confidence need review (unless arithmetic confirms them)
# REVIEW_TEXT_CONF_THRESHOLD=0.80
# PDF_RENDER_DPI=220
# PDF_OCR_DPI=300
# OCR_WARMUP=true               # prime the OCR models at startup so the first scan is not slow

# ---------------------------------------------------------------------------
# Storage & limits
# ---------------------------------------------------------------------------
# DATA_DIR=./data                                            # uploads, page images, SQLite database
# DATABASE_URL=postgresql+psycopg://scanwise:scanwise@localhost:5432/scanwise   # default: SQLite in DATA_DIR
# CORS_ORIGINS=["http://localhost:3000"]
# MAX_UPLOAD_MB=40
# MAX_FILES_PER_REQUEST=30
# MAX_PAGES_PER_DOCUMENT=40
# WORKER_CONCURRENCY=2
# LOG_LEVEL=INFO
